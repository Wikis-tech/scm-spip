# Public browser configuration (safe to expose; RLS must protect data)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
DATABASE_URL=
SUPABASE_DB_PASSWORD=
POSTGRES_PASSWORD=

# Apollo (server only)
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/api/v1
APOLLO_TIMEOUT=15000
APOLLO_MAX_RETRIES=3
APOLLO_RETRY_DELAY=1000
APOLLO_DAILY_LIMIT=5000

# Phase 6 AI provider router - all keys are SERVER ONLY.
# Configure at least one provider. More providers improve continuity when a service
# is rate-limited or temporarily unavailable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Set true only after SCM approves Groq for confidential data and ZDR/data controls.
GROQ_CONFIDENTIAL_ALLOWED=false
# Optional live web research. This can incur Groq Compound/search charges.
GROQ_COMPOUND_ENABLED=false
GROQ_COMPOUND_MODEL=groq/compound

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_CONFIDENTIAL_ALLOWED=false

ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash
ZAI_CONFIDENTIAL_ALLOWED=false

# Optional paid/overflow providers.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CONFIDENTIAL_ALLOWED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_CONFIDENTIAL_ALLOWED=false

# Independent optional fallback using Cloudflare's OpenAI-compatible Workers AI endpoint.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
CLOUDFLARE_CONFIDENTIAL_ALLOWED=false

# Recommended order: primary, independent fallback, overflow/router fallback.
AI_PROVIDER_ORDER=groq,cerebras,cloudflare,openrouter,deepseek,zai
AI_PROVIDER_TIMEOUT_MS=45000
AI_MAX_HISTORY_MESSAGES=18
AI_MAX_CONTEXT_CHARS=48000
APP_URL=https://scm-spip.vercel.app

# Legacy Gemini remains available to older routes until Phase 6 migration is complete.
# Do not route confidential SCM data through a free Gemini tier unless SCM approves its data terms.
GEMINI_API_KEY=

# Notifications / email - server only except VAPID public key
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
SMTP_FROM=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=

# Vercel Cron authentication for Friday weekly-report auto-submission.
# Generate a long random value and configure it as a sensitive Preview + Production variable.
CRON_SECRET=

# Microsoft 365 - Phase 5 (may remain pending while IT provides tenant credentials)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TOKEN_ENCRYPTION_KEY=

DEMO_MODE=false
